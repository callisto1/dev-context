# PostgreSQL
DATABASE_URL=postgresql+asyncpg://devctx:devctx@localhost:5432/dev_context_engine

# Ollama (runs as a Docker service, see docker-compose.yml)
# After starting, pull the model: docker exec -it <ollama_container> ollama pull qwen2.5-coder:14b
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5-coder:14b
LLM_API_KEY=not-needed

# Embedding model — Voyage voyage-code-3 (best for code retrieval).
# Modes: "voyage" (Voyage AI API), "local" (sentence-transformers), "remote" (OpenAI-compatible)
EMBEDDING_MODE=voyage
EMBEDDING_MODEL=voyage-code-3
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=your-voyage-api-key-here
# Only needed if EMBEDDING_MODE=remote (generic OpenAI-compatible endpoint)
# EMBEDDING_BASE_URL=http://your-gpu-server:8001/v1

# RAG settings
RAG_TOP_K=10
RAG_RETRIEVAL_K=30
RAG_SIMILARITY_THRESHOLD=0.3

# Reranker — cross-encoder that re-scores retrieval candidates for precision.
# Retrieves RAG_RETRIEVAL_K candidates, reranks to RERANKER_TOP_N.
RERANKER_ENABLED=true
RERANKER_MODE=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=5
# Only needed if RERANKER_MODE=remote (e.g. Cohere rerank API)
# RERANKER_BASE_URL=https://api.cohere.com/v1
# RERANKER_API_KEY=your-key

# Git ingestion
GIT_CLONE_DIR=/tmp/dev-context-engine/repos
# GitHub/GitLab personal access token for cloning private repos (leave empty for public only)
GIT_TOKEN=

# Confluence Cloud
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USER_EMAIL=you@company.com
CONFLUENCE_API_TOKEN=your-api-token-here

# Reindex scheduler
REINDEX_ENABLED=true
REINDEX_DEFAULT_CRON=0 0 * * *
